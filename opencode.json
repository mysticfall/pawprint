{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "blender": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "{env:BLENDER_MCP_HOME}",
        "run",
        "blender-mcp"
      ],
      "enabled": true
    },
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    }
  }
}
